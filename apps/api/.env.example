# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sleekndchic?schema=public"

# Redis (optional — app degrades gracefully without it)
REDIS_URL="redis://localhost:6379"

# JWT — REQUIRED, no fallback in code
JWT_SECRET="dev-only-jwt-secret-change-in-production-64-chars-min"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-in-production-64-chars-min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Paystack (get test keys from dashboard.paystack.com)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Email (SendGrid)
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
FROM_EMAIL="noreply@sleekndchic.com"
ADMIN_EMAIL="admin@sleekndchic.com"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_STAGING=
API_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
