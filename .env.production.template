# SleekNDChic Production Environment Template
# Copy this file to apps/api/.env and apps/web/.env.production
# Replace all placeholder values with your actual production values

# ============================================
# API ENVIRONMENT VARIABLES (apps/api/.env)
# ============================================

# Database - PostgreSQL (use managed DB: Neon, Supabase, Railway)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/sleekndchic?schema=public&sslmode=require"

# Redis - For caching and job queues (use Upstash for serverless, or managed Redis)
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# JWT Secrets - Generate strong random strings: openssl rand -base64 64
JWT_SECRET="GENERATE_A_STRONG_SECRET_HERE"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_STRONG_SECRET_HERE"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Paystack - Production Keys (get from dashboard.paystack.com)
PAYSTACK_SECRET_KEY="sk_live_YOUR_PAYSTACK_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="pk_live_YOUR_PAYSTACK_PUBLIC_KEY"

# Email (SendGrid) - Production API Key
SENDGRID_API_KEY="SG.YOUR_PRODUCTION_SENDGRID_API_KEY"
FROM_EMAIL="noreply@sleekndchic.com"
ADMIN_EMAIL="admin@sleekndchic.com"

# App Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://sleekndchic.vercel.app"
FRONTEND_URL_STAGING="https://sleekndchic-staging.vercel.app"
API_URL="https://api.sleekndchic.com"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# WEB ENVIRONMENT VARIABLES (apps/web/.env.production)
# ============================================

VITE_API_URL="https://api.sleekndchic.com/api/v1"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_YOUR_PAYSTACK_PUBLIC_KEY"
VITE_APP_NAME="SleekNDChic"
VITE_APP_URL="https://sleekndchic.vercel.app"
